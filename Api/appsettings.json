{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "broker",
    "Port": 5672,
    "UserName": "fileconverter",
    "Password": "DevPassword123!"
  },
  "InternalApi": {
    "Key": "LocalWorkerKey123!"
  },
  "ClientConfig": {
    "BaseAddress": "http://hidden-api:8000",
    "TimeoutSeconds": 300
  },
  "DatabaseConfig": {
    "DefaultConnection": "Server=sqldb;Database=FileConverter;User ID=sa;Password=DevPassword123!;TrustServerCertificate=True;"
  },
  "JwtConfig": {
    "Secret": "SuperExtraSecretJwtKey1234567890",
    "Issuer": "FileConverterApi",
    "Audience": "FileConverterClient",
    "ValidateIssuer": "true",
    "ValidateAudience": "true",
    "ValidateLifetime": "true",
    "ValidateIssuerSigningKey": "true",
    "AccessTokenValidMinutes": 30,
    "RefreshTokenValidDays": 5
  },
  "ObjectStorageConfig": {
    "Endpoint": "http://storage:9000",
    "AccessKey": "fileconverter",
    "SecretKey": "DevPassword123!",
    "WithSSL": "false"
  },
  "ObjectStorageBucketConfig": {
    "MainBucketName": "user-files",
    "UserImageSubDirectpry": "images",
    "UserVideosSubDirectory": "videos",
    "UserAudiosDubDirectory": "audios",
    "UserDocumentsSubDirecotry": "documents"
  },
  "UploadedFilesOptions": {
    "AllowedImageFileFormats": [
      "jpeg", "jpg", "png", "webp", "ppm", "bmp", "heic"
    ],
    "AllowedVideoFileFormats": [
      "mp4", "webm"
    ],
    "AllowedAudioFileFormats": [
      "mp3", "wav", "ogg", "flac", "aac"
    ],
    "AllowedDocumentFileFormats": [
      "pdf", "docx"
    ],
    "MaxImageFileSizeMb": 500,
    "MaxVideoFileSizeMb": 500,
    "MaxAudioFileSizeMb": 50,
    "MaxDocumentFileSizeMb": 5
  }
}
